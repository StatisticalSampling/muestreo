cong.media<-function (y, N, M, V, v = 0, d = 5, alfa = 0.05)
{
if (v == 0) {
v <- V
g <- length(V)
cat("\n", "CON1(", N, ",", M, ",", g, ")", "\n", "\n")
congl.media(y, V, v, N, M, d, alfa)
}
else {
if (length(v) == length(V)) {
L <- length(V)
j <- 1
cat("\n", "CON2(", N, ",", M, ",", L)
while (j <= L) {
cat(",{", V[j], ",", v[j], "}")
j <- j + 1
}
cat(")", "\n")
congl.media(y, V, v, N, M, d, alfa)
}
else {
cat("\n", "El número de conglomerados poblacionales NO coincide con el número de conglomerados muestrales.",
"\n")
}
}
}
y=c(1:1000)
cong.media(y)
cong.media(y,v=0)
