else {
if (estrato != 1) {
a <- sum(m[1:estrato - 1]) + 1
b <- a + m[estrato] - 1
mas.razon(numerador[a:b], denominador[a:b],
M[estrato], alfa)
}
else {
mas.razon(numerador[1:m[1]], denominador[1:m[1]],
M[1], alfa)
}
}
}
}
}
